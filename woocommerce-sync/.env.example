# Lager-MC PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lagerdb_woocommerce
DB_USER=lager
DB_PASS=
# WooCommerce MySQL/MariaDB: only bridge tables are accessed
WOO_DB_HOST=
WOO_DB_PORT=3306
WOO_DB_NAME=
WOO_DB_USER=
WOO_DB_PASS=
WOO_TABLE_PREFIX=wp_
# Optional: CA file for verified TLS (recommended for remote database connections)
WOO_DB_SSL_CA=
# read-only imports snapshots; read-write additionally processes warehouse changes
WOO_SYNC_MODE=read-only
SYNC_INTERVAL=30
SYNC_BATCH_SIZE=200
# Fail visibly when the WordPress cron bridge stops updating its heartbeat
WOO_BRIDGE_MAX_AGE=300
